# {{ ansible_managed }}

log_format custom   '$remote_addr - $remote_user [$time_local] '
                    '"$request" $status $body_bytes_sent $request_time $upstream_response_time '
                    '"$server_name" '
                    '"$http_referer" "$http_user_agent" "$http_x_forwarded_for"';

access_log /var/log/nginx/{{ reverse_proxy_name }}-access.log custom;
error_log /var/log/nginx/{{ reverse_proxy_name }}-error.log;
gzip on;

# Resolve Docker service names through the embedded DNS server at request time.
# This allows the proxy to start before all application containers are created.
resolver 127.0.0.11 valid=30s;

# Do no respond to plain host over https
server {
    listen 80 default_server;
    if ($host ~ ^(.*)\.{{ reverse_proxy_wildcard | replace(".", "\.") }}$ ) {
        rewrite ^(.*) https://$host$1 permanent;
    }
    if ($host !~ ^(.*)\.{{ reverse_proxy_wildcard | replace(".", "\.") }}$ ) {
        rewrite ^(.*) https://$host.{{ reverse_proxy_wildcard }}$1 permanent;
    }
}

# Catch unknown
server {
    listen 443 ssl default_server;

    ssl_certificate /etc/nginx/certs/{{ reverse_proxy_default_cert | default('ssl') }}.pem;
    ssl_certificate_key /etc/nginx/certs/{{ reverse_proxy_default_cert | default('ssl') }}.key;

    return 444;
}

{% for item in reverse_proxy_services %}
server {
    listen 443 ssl;
    server_name {{ item.name }}.{{ reverse_proxy_wildcard }};
    ssl_certificate /etc/nginx/certs/{{ item.cert | default("ssl") }}.pem;
    ssl_certificate_key /etc/nginx/certs/{{ item.cert | default("ssl")}}.key;

    location / {
        {% if item.host is defined %}
        set $reverse_proxy_upstream "{{ item.scheme | default('http') }}://{{ item.host }}:{{ item.port | default(80) }}";
        {% if item.suffix is defined %}
        proxy_pass $reverse_proxy_upstream{{ item.suffix }}/;
        {% else %}
        # Preserve the requested URI for applications served at their root.
        proxy_pass $reverse_proxy_upstream;
        {% endif %}
        {% else %}
        proxy_pass {{ item.scheme | default("http") }}://{{ item.ip }}:{{ item.port | default(80) }}{{ item.suffix | default('') }}/;
        {% endif %}
        proxy_http_version 1.1;
        proxy_set_header Host {{ item.header_host | default('$host') }};
        {% if item.forwarded_headers | default(true) %}
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        {% endif %}
        proxy_hide_header X-Frame-Options;
        proxy_set_header X-Frame-Options "SAMEORIGIN";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        client_max_body_size 0;
        proxy_connect_timeout  3600s;
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        send_timeout  3600s;
    }
    {{ item.server_extra | default("") }}
}

{% endfor %}
